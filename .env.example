# ── DATABASE ──────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require"

# ── NEXTAUTH ──────────────────────────────────
AUTH_SECRET="generate-dengan-openssl-rand-base64-32"
# Wajib diubah ke domain Vercel production: https://namaproject.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── CLOUDINARY ────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Storage limit in bytes (default 25GB for free plan). Set sesuai plan Cloudinary kamu.
CLOUDINARY_STORAGE_LIMIT_BYTES="26843545600"

# ── UPSTASH REDIS ─────────────────────────────
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# ── SMTP (Email) ───────────────────────────────
# Gmail: gunakan App Password (butuh 2FA enabled)
# Buat di: https://myaccount.google.com/apppasswords
# Provider lain: isi SMTP_HOST, SMTP_PORT sesuai provider
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM_EMAIL="your-email@gmail.com"
# Nama pengirim yang tampil di inbox Gmail (default: "ND Journey")
SMTP_FROM_NAME="ND Journey"

# ── PUSHER (Real-time Sync) ────────────────────
PUSHER_APP_ID="your_pusher_app_id"
PUSHER_SECRET="your_pusher_secret"
NEXT_PUBLIC_PUSHER_APP_KEY="your_pusher_app_key"
NEXT_PUBLIC_PUSHER_CLUSTER="your_pusher_cluster"

# ── VAPID (Web Push) ───────────────────────────
# Generate a key pair locally: npx web-push generate-vapid-keys
# Real values live in .env (git-ignored, never committed) and Vercel env vars
# (a manual one-time step for the user). NEXT_PUBLIC_VAPID_PUBLIC_KEY is read
# by client code via process.env.NEXT_PUBLIC_*.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
# VAPID subject (contact for the push service). Must be a mailto: address or an
# https: URL — Apple rejects the request outright when the subject is malformed.
CONTACT_EMAIL="mailto:you@example.com"

# ── CRON ──────────────────────────────────────
CRON_SECRET="generate-strong-random-secret-untuk-cron-job"

# ── LOCATION UPSTREAMS (opsional) ─────────────
# Tidak perlu diisi: default-nya endpoint publik resmi, tanpa API key/signup.
# - OSRM demo: non-komersial, maks 1 req/detik, tanpa jaminan uptime.
# - Nominatim: maks 1 req/detik, User-Agent wajib mengidentifikasi aplikasi.
# Env override dipakai untuk pindah ke instance sendiri/berizin tanpa update
# kode (diminta oleh kebijakan Nominatim).
# OSRM_BASE_URL="https://router.project-osrm.org"
# NOMINATIM_URL="https://nominatim.openstreetmap.org/reverse"
# NOMINATIM_USER_AGENT="NdJourney/1.0 (https://ndjourney.vercel.app)"

# ── NATIVE (Capacitor) ────────────────────────
# UI yang dimuat di APK/IPA. Kosongkan = pakai NEXTAUTH_URL / ndjourney.vercel.app.
# Untuk development di HP: http://IP-LAN-KAMU:3000 (CAP_SERVER_URL) dan set
# capacitor.config.ts cleartext:true sementara saat dev.
# CAP_SERVER_URL="https://ndjourney.vercel.app"

# GitHub repo that hosts the APK release assets (owner/repo).
# Only change this if the repo is renamed/forked: the update API and /get-app
# must point at the same release the CI workflow publishes.
# NEXT_PUBLIC_NATIVE_GITHUB_REPO="nikodwicahyo/ndjourney"

# ── APP CONFIG ────────────────────────────────
INVITE_TOKEN="rahasia-invite-token-untuk-registrasi-pasangan"

# Seed (wajib min 12 karakter, jangan pakai password lemah)
SEED_PASSWORD="ganti-dengan-password-kuat-min-12-karakter"
